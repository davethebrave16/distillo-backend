# Emulator params (copied to .env.local by ./setup.sh; gitignored). Not secrets.

# Firebase Auth uid of the single allowed user. Get it from the Auth emulator UI
# (http://127.0.0.1:4000 -> Authentication -> your user -> User UID), or from the
# Firebase console for production. Must match allowedUid() in firestore.rules.
ALLOWED_UID=REPLACE_WITH_UID

# Gmail window in days (query: label:news newer_than:Nd). Raise it for a backfill.
INGEST_LOOKBACK_DAYS=3

# Max NEW mails processed per run (already-stored mails do not count; the rest waits for the next run).
INGEST_MAX_MESSAGES=10
