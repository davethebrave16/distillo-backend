# Emulator secrets (copied to .secret.local by ./setup.sh; gitignored). Never commit real values.
# No quotes, one KEY=value per line.

# OAuth client of type "Desktop app" (Google Cloud console -> APIs & Services -> Credentials).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Printed once by: GMAIL_CLIENT_ID=... GMAIL_CLIENT_SECRET=... functions/venv/bin/python scripts/gmail_auth.py
GMAIL_REFRESH_TOKEN=
